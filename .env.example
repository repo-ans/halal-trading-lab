# Copy to .env and fill in. NEVER commit .env or real keys.

# --- Backend ---
# Supabase Postgres connection string (Project Settings > Database).
# Use the psycopg3 driver prefix. Use the session-pooler or direct string.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Used only by tests that write data (RUN_DB_TESTS=1). Defaults to the throwaway
# local Postgres started by `docker compose --profile test up -d db_test` (see
# docker-compose.yml) -- you normally don't need to set this. The test harness
# refuses to run if it equals DATABASE_URL or its host isn't localhost/127.0.0.1,
# so it can never be pointed at the production Supabase project.
TEST_DATABASE_URL=

# Supabase project URL, e.g. https://YOUR_PROJECT_REF.supabase.co
SUPABASE_URL=

# Optional. Only for projects still on the legacy HS256 JWT secret
# (Project Settings > API > JWT Secret). Leave empty to verify tokens via the
# project's JWKS endpoint instead (newer projects).
SUPABASE_JWT_SECRET=

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

APP_ENV=development

# CLAUDE.md section 3: yfinance/Yahoo is NOT licensed for production use -- dev only.
# Must be explicitly true for YFinanceProvider to run at all.
ALLOW_DEV_DATA_SOURCE=false

# Shared secret required (as the X-Job-Secret header) to call POST /jobs/backfill.
# Leave empty to disable the endpoint entirely (it refuses with 503, never falls
# back to "no auth required"). Set to a long random value in any deployed environment
# -- this is what GitHub Actions cron uses to trigger the backfill externally.
JOB_SECRET=

# Comma-separated Supabase auth user UUIDs allowed to write compliance records
# (admin form + CSV import). Empty/unset means NO ONE is admin -- fail closed.
ADMIN_USER_IDS=

# Stage H. Comma-separated Supabase auth user UUIDs allowed to use the app at
# all. Empty/unset means NO ONE is allowed -- fail closed. ADMIN_USER_IDS members
# count as allowed automatically. Also disable public sign-ups in the Supabase
# dashboard (Authentication > Providers) so a stranger can't obtain a valid JWT
# in the first place -- this env var alone is not the only gate.
ALLOWED_USER_IDS=

# Stage H licence guard (CLAUDE.md section 3). Comma-separated Supabase auth
# user UUIDs who may see yfinance-sourced price data. Empty/unset means NO ONE
# is the owner -- fail closed; everyone, owner included, gets 503 until set.
OWNER_USER_IDS=

# Default validity window (days) for a new compliance record before it expires.
# CLAUDE.md section 5: an unconfirmed assumption, not yet owner-approved.
COMPLIANCE_DEFAULT_VALIDITY_DAYS=90

# Stage G. Anthropic API key for the AI summary's LLM mode. Empty disables LLM
# mode outright (template mode still works, sends nothing externally).
AI_API_KEY=

# Stage G. Model id for LLM summaries.
AI_MODEL=claude-haiku-5-5

# Stage G. Per-call timeout (seconds) for the LLM request.
AI_SUMMARY_TIMEOUT_SECONDS=15.0

# Stage G. Soft per-user rolling-24h cap on LLM attempts (success, failure, or
# guard rejection all count).
AI_SUMMARY_DAILY_CAP=5

# --- Frontend (also copy into frontend/.env.local) ---
# These are public by design (anon key is safe in the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8000
